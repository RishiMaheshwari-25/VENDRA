# Render environment variables (see VENDRA_Production_Changes.pdf)
NODE_ENV=production
MONGO_URI=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Frontend (Vercel) URL, no trailing slash
FRONTEND_URL=https://your-app.vercel.app
# Must be registered in Google Cloud Console as an Authorized redirect URI
GOOGLE_CALLBACK_URL=https://your-app.vercel.app/api/auth/google/callback
IMAGEKIT_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
# Set true if your Redis provider requires TLS (e.g. Upstash)
REDIS_TLS=false
